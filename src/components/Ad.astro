---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  headline: string;
  text: string;
  image?: ImageMetadata;
}

const { headline, text, image } = Astro.props;
---

<aside class:list={["ad", { "ad-banner": image }]}>
  {image && <Image src={image} alt={headline} widths={[500, 1000]} sizes="(max-width: 600px) 100vw, 460px" />}
  <div class="ad-text">
    <span class="ad-label">Publicité</span>
    <strong>{headline}</strong>
    <p>{text}</p>
  </div>
</aside>
