---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { sections, url } from "../lib/site";

interface Props {
  article: CollectionEntry<"articles">;
  size?: "hero" | "card";
}

const { article, size = "card" } = Astro.props;
const { title, lede, section, image, caption } = article.data;
---

<a class={`article-card ${size}`} href={url(`/articles/${article.id}/`)}>
  <Image src={image} alt={caption} widths={size === "hero" ? [600, 1200] : [400, 800]} sizes={size === "hero" ? "(max-width: 900px) 100vw, 800px" : "(max-width: 600px) 100vw, 400px"} />
  <div class="article-card-text">
    <span class="kicker">{sections[section]}</span>
    <h2>{title}</h2>
    {size === "hero" && <p>{lede}</p>}
  </div>
</a>
